{
  "name": "annotant",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "skills/annotant/widget",
    "playground",
    "demo"
  ],
  "scripts": {
    "build": "npm run build --workspace skills/annotant/widget",
    "build:dev": "npm run build:dev --workspace skills/annotant/widget",
    "watch": "npm run watch --workspace skills/annotant/widget",
    "playground": "npm run dev --workspace playground",
    "demo": "npm run dev --workspace demo",
    "site": "node .github/scripts/site-preview.mjs",
    "typecheck": "tsc -p skills/annotant/scripts && tsc -p .github/scripts && tsc -p test && tsc -p skills/annotant/widget && tsc -p playground && tsc -p demo && tsc -p .claude/skills/playground/scripts",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run lint:unused && npm run typecheck && npm run build && npm test",
    "test": "node --test \"test/**/*.test.mjs\" && npm test --workspace skills/annotant/widget",
    "test:hooks": "claude plugin validate .claude-plugin/plugin.json && claude plugin test ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "knip": "6.42.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10"
  }
}
