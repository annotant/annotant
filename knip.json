{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        // Loaded by Claude Code from hooks/hooks.json.
        "hooks/register.ts",
        // The scripts the skill and the worker run (`node SKILL/scripts/<name>.mjs`).
        "skills/code-buddy/scripts/*.mjs",
        // Run by the /playground skill.
        ".claude/skills/playground/scripts/*.mjs",
        // The plugin's types, named by .claude-plugin/plugin.json.
        "types/index.d.ts",
        // The suites, not every file under test/ (the Node.js plugin's default would hide an unused helper).
        "test/**/*.test.mjs",
        "test/hooks.test.ts"
      ],
      "node": false,
      // `typecheck` runs the TypeScript the workspaces install, hoisted to the root.
      "ignoreBinaries": ["tsc"],
      // claude-code and claude-code/testing: modules Claude Code provides to the hooks, not packages.
      "ignoreDependencies": ["claude-code"]
    },
    "skills/code-buddy/widget": {
      // Its Vitest suites (vitest.config.ts), not every file under test/.
      "node": false
    }
  }
}
